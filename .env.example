# ── Obligatorio en producción ────────────────────────────────
# Clave de firma de sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Railway la inyecta sola al vincular el servicio PostgreSQL.
# Si la dejas vacía, la app usa SQLite en ./data/levantamiento.db (solo local).
DATABASE_URL=

# ── Usuario administrador inicial (solo se crea la primera vez) ──
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame_ya_123
ADMIN_NOMBRE=Administrador

# ── Opcionales ───────────────────────────────────────────────
APP_NOMBRE=Levantamiento de Procesos
APP_ORG=
MAX_MEDIA_MB=25
SESSION_DIAS=14
DB_POOL_MAX=10

# Si defines MEDIA_DIR, las fotos y audios se guardan en disco
# (requiere un Volume de Railway montado en esa ruta).
# Si lo dejas vacío, se guardan dentro de PostgreSQL.
MEDIA_DIR=
